  "m3_notes": {
    "secondary": "One-accent rule: secondary is the neutral slate text tone, not a second hue.",
    "secondary_container": "Neutral raised chip (e.g. occupied workspace, toggles off) instead of a tinted container.",
    "tertiary": "One-accent rule: tertiary is a pale tint of the same cyan, never green (green is reserved for ready/ok).",
    "tertiary_container": "Same neutral chip as secondary_container so nothing introduces a third color.",
    "surface_variant": "ii uses it for input fields and chips; mapped to the overlay step so it sits above surface_container.",
    "surface_bright": "Dark-only theme: 'bright' is simply the highest surface step.",
    "surface_dim": "Same as container_lowest; the deepest navy from GRUB's background gradient.",
    "inverse_surface": "Snackbars/tooltips flip to near-white with navy text.",
    "inverse_primary": "Accent on the inverse (light) surface needs a darker cyan to keep 4.5:1.",
    "outline_variant": "Dividers: decorative hairline, same as GRUB's panel border.",
    "scrim": "Opaque hex here; apply 70% alpha where the shell draws it (token scrim = #060D1AB3).",
    "shadow": "Shadows are disabled; kept black so any leftover shadow is invisible on navy.",
    "surface_tint": "M3 tint overlays use the accent; ii keeps tint opacity low.",
    "primary_fixed": "Fixed roles are theme-independent; dark-only so they reuse the pale cyan.",
    "on_primary_fixed_variant": "Darker cyan for text on primary_fixed_dim (#22D3EE) at 4.5:1.",
    "on_tertiary_fixed_variant": "Same as on_primary_fixed_variant, tertiary is the same hue.",
    "on_secondary_fixed_variant": "Slate ink for text on secondary_fixed."
  },
  "terminal": {
    "background": "#0A1628",
    "foreground": "#C9D6E6",
    "cursor": "#22D3EE",
    "cursor_text": "#0A1628",
    "selection_background": "#155E75",
    "selection_foreground": "#EAFBFF",
    "url": "#67E8F9",
    "ansi0": "#4A658C",
    "ansi1": "#F0717F",
    "ansi2": "#3FC98F",
    "ansi3": "#E2B347",
    "ansi4": "#5C9DF5",
    "ansi5": "#C08CF5",
    "ansi6": "#22D3EE",
    "ansi7": "#B4C4D8",
    "ansi8": "#7189AA",
    "ansi9": "#FF9AA5",
    "ansi10": "#6EE7B7",
    "ansi11": "#FAD27A",
    "ansi12": "#93C0FF",
    "ansi13": "#DDB8FF",
    "ansi14": "#8BEFFF",
    "ansi15": "#EAFBFF"
  },
  "shape": {
    "radius_window_px": 0,
    "radius_bar_px": 0,
    "radius_popup_px": 0,
    "radius_button_px": 0,
    "radius_input_px": 0,
    "border_width_active_px": 2,
    "border_width_inactive_px": 2,
    "gaps_in_px": 4,
    "gaps_out_px": 16,
    "gap_between_windows_px": 8,
    "window_padding_px": 16,
    "bracket_length_px": 16,
    "bracket_thickness_px": 2,
    "hairline_px": 1,
    "accent_bar_px": 3,
    "grid_px": 8,
    "bar_height_px": 40,
    "blur": {
      "enabled": true,
      "layers": [
        "bar",
        "sidebars",
        "notifications",
        "osd",
        "fuzzel",
        "session",
        "overview"
      ],
      "windows": false,
      "size": 8,
      "passes": 2,
      "noise": 0.0,
      "contrast": 1.0,
      "brightness": 1.0,
      "vibrancy": 0.0,
      "xray": false
    },
    "layer_opacity": 0.92,
    "shadow": {
      "enabled": false
    },
    "window_opacity_active": 1.0,
    "window_opacity_inactive": 1.0,
    "dim_inactive": false,
    "window_margin_px": 0
  },
  "motion": {
    "curves": {
      "term": [
        0.2,
        0.0,
        0.0,
        1.0
      ],
      "term_exit": [
        0.4,
        0.0,
        1.0,
        1.0
      ],
      "linear": [
        0.0,
        0.0,
        1.0,
        1.0
      ]
    },
    "window_open": {
      "ms": 200,
      "curve": "term",
      "style": "popin 96%"
    },
    "window_close": {
      "ms": 150,
      "curve": "term_exit",
      "style": "popin 96%"
    },
    "window_move": {
      "ms": 200,
      "curve": "term"
    },
    "workspace_switch": {
      "ms": 225,
      "curve": "term",
      "style": "slide"
    },
    "layer_in": {
      "ms": 175,
      "curve": "term",
      "style": "slide + fade"
    },
    "layer_out": {
      "ms": 125,
      "curve": "term_exit",
      "style": "fade"
    },
    "fade": {
      "ms": 150,
      "curve": "term"
    },
    "border_color": {
      "ms": 150,
      "curve": "linear"
    },
    "max_ms": 225,
    "overshoot": false
  },
  "fonts": {
